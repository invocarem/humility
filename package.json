{
  "name": "bernard-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "start": "npm run build && electron .",
    "lexicon:extract": "python tools/extract_wordlist.py",
    "lexicon:analyze": "bash tools/analyze-in-docker.sh",
    "lexicon:parse": "python tools/parse_analyses.py",
    "lexicon:curate": "python tools/apply_overrides.py",
    "ingest:verify": "python tools/ingest_latin.py",
    "ingest:scaffold": "python tools/ingest_latin.py --scaffold",
    "ingest:psalter-english": "python tools/ingest_psalter_english.py",
    "ingest:rule-english": "python tools/ingest_rule_english.py",
    "ingest:confessions": "python tools/ingest_confessions.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "wait-on": "^8.0.3"
  }
}
